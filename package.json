{
  "name": "mairie-portal-app",
  "private": true,
  "version": "1.0.0",
  "description": "Portail applicatif Marie de L'Haÿ-les-Roses avec une application Planning ATSEM",
  "scripts": {
    "postinstall": "npm install --prefix client",
    "start": "ts-node server/index.ts",
    "dev": "concurrently \"npm run dev --prefix client\" \"nodemon\"",
    "build": "npm run build --prefix client",
    "test": "ts-node --project server/tsconfig.json server/vacations.test.ts && ts-node --project server/tsconfig.json server/export.test.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}

