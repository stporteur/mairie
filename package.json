{
  "name": "mairie-portal-app",
  "private": true,
  "version": "1.0.0",
  "description": "Portail applicatif Marie de L'Haÿ-les-Roses avec une application Planning ATSEM",
  "scripts": {
    "postinstall": "npm install --prefix client",
