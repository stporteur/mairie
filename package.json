    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "express": "^4.18.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
