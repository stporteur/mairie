{
  "name": "mairie-portal-app",
  "private": true,
  "version": "1.0.0",
  "description": "Portail applicatif Marie de L'Haÿ-les-Roses",
  "scripts": {
    "postinstall": "npm install --prefix client",
    "start": "ts-node server/index.ts",
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev:server\"",
    "dev:server": "node --watch-path=server --watch-path=shared --require ts-node/register server/index.ts",
    "build": "npm run build --prefix client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:legacy": "ts-node --project server/tsconfig.json server/vacations.test.ts && ts-node --project server/tsconfig.json server/export.test.ts && ts-node --project server/tsconfig.json server/forecastExport.test.ts",
    "test:jest": "jest",
    "test": "npm run test:legacy && npm run test:jest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "js-yaml": "^4.1.1"
  }
}
